@model ProductModel
@{
    ViewData["Title"] = "Деталі товару";
}
<section class="panel narrow">
    <p class="eyebrow">Картка товару</p><h1>@Model.Name</h1>
    <dl class="details-list"><dt>Ідентифікатор</dt><dd>@Model.Id</dd><dt>Ціна</dt><dd>@Model.Price.ToString("N2") грн</dd><dt>Тип</dt><dd>@(Model is PhoneModel ? "Телефон" : Model is LaptopModel ? "Ноутбук" : "Товар")</dd>
    @if (Model is PhoneModel phone) { <dt>Бренд</dt><dd>@phone.Brand</dd><dt>Пам’ять</dt><dd>@phone.Memory GB</dd><dt>ОС</dt><dd>@phone.OperatingSystem</dd> }
    @if (Model is LaptopModel laptop) { <dt>Бренд</dt><dd>@laptop.Brand</dd><dt>RAM</dt><dd>@laptop.Ram GB</dd><dt>Процесор</dt><dd>@laptop.Processor</dd> }
    </dl>
    <div class="actions"><a class="button" asp-action="Edit" asp-route-id="@Model.Id">Редагувати</a><a class="button button-light" asp-action="Index">Назад</a></div>
</section>
