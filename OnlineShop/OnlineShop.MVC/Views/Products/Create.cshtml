@model ProductFormModel
@{
    ViewData["Title"] = "Додати товар";
}
<section class="panel narrow">
    <h1>Додати товар</h1>
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="validation"></div>
        <label asp-for="Name"></label><input asp-for="Name" /><span asp-validation-for="Name" class="validation"></span>
        <label asp-for="Price"></label><input asp-for="Price" type="number" step="0.01" min="0" /><span asp-validation-for="Price" class="validation"></span>
        <div class="actions"><button class="button" type="submit">Зберегти</button><a class="button button-light" asp-action="Index">Скасувати</a></div>
    </form>
</section>
